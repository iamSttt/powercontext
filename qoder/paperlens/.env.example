# ===== seekdb（MySQL 协议）=====
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DB=paperlens
SEEKDB_CONNECT_TIMEOUT=5

# ===== MiniMax（OpenAI 兼容接口）=====
# 必填：https://platform.minimaxi.com 申请后填入，切勿提交到仓库
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_MAX_TOKENS=2048
MINIMAX_TIMEOUT=90

# ===== PaperLens 行为 =====
# 单块最大字数
PAPERLENS_CHUNK_CHARS=600
# 检索返回段落数
PAPERLENS_TOP_K=5
# 没有 API Key 或模型调用失败时，是否降级为"检索原文摘录"（1 开启 / 0 关闭）
PAPERLENS_OFFLINE_ANSWER=1
# 单次导入正文字符上限
PAPERLENS_MAX_CONTENT_CHARS=2000000
