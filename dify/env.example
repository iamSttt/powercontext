# Dify 1.10.1 .env 关键配置示例（放在 dify/docker/.env）
# 完整文件请以官方 docker/.env.example 为底，覆盖以下项

# 安全
SECRET_KEY=请替换为随机64位十六进制
INIT_PASSWORD=请替换为首次登录的设置密码

# 数据库：seekdb（兼容 MySQL 协议）
DB_TYPE=mysql
DB_HOST=host.docker.internal
DB_PORT=2881
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=dify

# 向量库：OceanBase / seekdb（与数据库同一实例）
VECTOR_STORE=oceanbase
OCEANBASE_VECTOR_HOST=host.docker.internal
OCEANBASE_VECTOR_PORT=2881
OCEANBASE_VECTOR_USER=root
OCEANBASE_VECTOR_PASSWORD=
OCEANBASE_VECTOR_DATABASE=dify

# 端口
EXPOSE_NGINX_PORT=3000

# 不启用官方 compose 内置的 postgres/mysql/weaviate/oceanbase 服务
COMPOSE_PROFILES=
